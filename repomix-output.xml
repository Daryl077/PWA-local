    }
    .diagram-nav-percent {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    /* Mode buttons carry a small glyph so the dock reads as one icon language. */
    .diagram-nav #btn-route-probe,
