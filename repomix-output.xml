      left: 1.25rem;
      width: 3.25rem;
      border-top: 3px solid var(--arrow-emphasis);
      content: "";
    }
    html[data-preset="editorial"] .card-dot { border-radius: 0; transform: rotate(45deg) scale(0.78); }

    /* Summary rail: the reader measures the viewport and enables it only when the
       diagram keeps its readable width beside the notes. */
    .reader-rail { display: contents; }
    html[data-reader-rail="true"] .container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--archify-rail-width);
      grid-auto-flow: row dense;
      column-gap: var(--archify-rail-gap);
      align-items: start;
    }
    html[data-reader-rail="true"] .container > .header { grid-column: 1 / -1; }
    html[data-reader-rail="true"] .container > .diagram-container { grid-column: 1; }
    /* The rail is at least the diagram's height and may run on to the viewport
       floor (--archify-rail-max, set by the reader); past that, notes scroll and
       the index keeps a usable share instead of collapsing to its header. */
    html[data-reader-rail="true"] .reader-rail {
