    .ambient-flow-glow {
      --flow-peak: var(--flow-glow-peak, 0.5);
      stroke-width: 9;
      stroke-dasharray: var(--flow-dash, 12px) calc(var(--flow-len, 0px) - var(--flow-dash, 12px));
      filter: blur(2.5px);
    }
    .ambient-flow-tail {
      --flow-peak: var(--flow-tail-peak, 0.42);
      stroke-width: 2.4;
      stroke-dasharray: var(--flow-dasharray, var(--flow-dash, 20px) calc(var(--flow-len, 0px) - var(--flow-dash, 20px)));
    }
    .ambient-flow-head {
      --flow-peak: var(--flow-head-peak, 0.95);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 40%, white);
      stroke-width: 2.6;
      stroke-dasharray: var(--flow-dash, 6px) calc(var(--flow-len, 0px) - var(--flow-dash, 6px));
    }
    .ambient-flow-ripple {
      --flow-peak: var(--flow-ripple-peak, 0.65);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, white);
      stroke-width: 2;
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden]) .ambient-edge-flow {
      display: inline;
      animation-name: var(--flow-name, none);
      animation-duration: var(--flow-cycle, 6.4s);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-delay: var(--flow-delay, 0s);
      /* Without backwards fill a delayed layer would sit at its natural opacity
