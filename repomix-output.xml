    /* Collapsed: only the reveal control remains, so the diagram takes the width. */
    html[data-reader-rail="collapsed"] .reader-rail { display: none; }
    /* Overlay: a drawer for diagrams whose readable floor leaves no room to dock. */
    html[data-reader-rail="overlay"] .reader-rail {
      position: fixed;
      z-index: 150;
      top: 1rem;
      right: 1rem;
      bottom: 1rem;
      display: flex;
      flex-direction: column;
      width: var(--archify-rail-width);
      padding: 0.75rem 1rem 0.5rem;
      border: 1px solid color-mix(in srgb, var(--panel-border) 90%, transparent);
      border-radius: 1rem;
      background: var(--toolbar-menu-bg);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 28px 64px -18px rgba(15, 23, 42, 0.38);
