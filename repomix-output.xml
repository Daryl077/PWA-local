    /* Dashed boundary variants */
    .c-security-group { fill: transparent; stroke: var(--security-stroke); stroke-dasharray: 4,4; }
    .c-region         { fill: rgba(251, 191, 36, 0.05); stroke: var(--cloud-stroke); stroke-dasharray: 8,4; }
    .c-lane           { fill: var(--lane-fill); stroke: var(--lane-stroke); stroke-dasharray: 6,6; }

    /* Live plays one relay per cycle: a comet (halo, tail, head) leaves each
       source when the signal reaches it, travels at one shared speed, leaves a
       soft wake, and lands as a ripple while its target glows. Downstream edges
       depart only after their source is reached, so the reader sees the path the
       diagram describes rather than every edge shimmering at once. Sequence
       messages relay in authored chronological order. Motion Governor plans the
       timeline and its per-edge keyframes; this stylesheet owns appearance.
       Original line language and markers remain static. Node entry is bounded to
       one pass per document. */
    svg[data-animation="trace"] {
      --flow-cycle: 6.4s;
      --flow-halo-peak: 0.17;
      --flow-glow-peak: 0.5;
      --flow-tail-peak: 0.42;
      --flow-head-peak: 0.95;
      --flow-wake-peak: 0.3;
      --flow-ripple-peak: 0.65;
    }
    .ambient-edge-flow {
      fill: none;
      stroke: var(--arrow-emphasis);
      stroke-linecap: round;
      pointer-events: none;
      display: none;
    }
    .ambient-flow-wake {
      --flow-peak: var(--flow-wake-peak, 0.3);
      stroke-width: 3.2;
      stroke-dasharray: var(--flow-dasharray, none);
    }
    .ambient-flow-halo {
      --flow-peak: var(--flow-halo-peak, 0.17);
      stroke-width: 6;
      stroke-dasharray: var(--flow-dash, 12px) calc(var(--flow-len, 0px) - var(--flow-dash, 12px));
    }
    /* A wide blurred streak centered on the head: this is the bloom that makes
       the comet read as a traveling orb of light rather than a bright dash. */
    .ambient-flow-glow {
      --flow-peak: var(--flow-glow-peak, 0.5);
      stroke-width: 9;
      stroke-dasharray: var(--flow-dash, 12px) calc(var(--flow-len, 0px) - var(--flow-dash, 12px));
      filter: blur(2.5px);
    }
    .ambient-flow-tail {
      --flow-peak: var(--flow-tail-peak, 0.42);
      stroke-width: 2.4;
      stroke-dasharray: var(--flow-dasharray, var(--flow-dash, 20px) calc(var(--flow-len, 0px) - var(--flow-dash, 20px)));
    }
    .ambient-flow-head {
      --flow-peak: var(--flow-head-peak, 0.95);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 40%, white);
      stroke-width: 2.6;
      stroke-dasharray: var(--flow-dash, 6px) calc(var(--flow-len, 0px) - var(--flow-dash, 6px));
    }
    .ambient-flow-ripple {
      --flow-peak: var(--flow-ripple-peak, 0.65);
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, white);
      stroke-width: 2;
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden]) .ambient-edge-flow {
      display: inline;
      animation-name: var(--flow-name, none);
      animation-duration: var(--flow-cycle, 6.4s);
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-delay: var(--flow-delay, 0s);
      /* Without backwards fill a delayed layer would sit at its natural opacity
         (fully lit) until its departure arrives. */
      animation-fill-mode: backwards;
    }
    /* Stream packets trail the comet head as smaller, dimmer beads. */
    .ambient-flow-head.packet {
      --flow-peak: calc(var(--flow-head-peak, 0.95) * 0.62);
      stroke-width: 3.4;
    }
    /* Timeline and waterfall playhead: a crisp rule over a soft bloom. */
    .ambient-flow-playhead {
      --flow-peak: 0.9;
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, white);
      stroke-width: 1.6;
    }
    .ambient-flow-playhead-glow {
      --flow-peak: 0.32;
      stroke-width: 10;
      filter: blur(4px);
    }
    /* Waterfall spans fill in proportion to their measured time, then settle. */
    .ambient-flow-fill {
      --flow-peak: 0.5;
      fill: color-mix(in srgb, var(--flow-fill, var(--arrow-emphasis)) 55%, white);
      stroke: none;
      transform-box: fill-box;
      transform-origin: left center;
    }
    .ambient-flow-fill-failed { fill: var(--security-stroke); --flow-peak: 0.5; }
    html[data-theme="light"] .ambient-flow-playhead { stroke: color-mix(in srgb, var(--arrow-emphasis) 70%, black); }
    html[data-theme="light"] .ambient-flow-fill { --flow-peak: 0.42; fill: color-mix(in srgb, var(--flow-fill, var(--arrow-emphasis)) 70%, black); }
    svg[data-preset="editorial"] .ambient-flow-fill { --flow-peak: 0.2; }
    svg[data-preset="editorial"] .ambient-flow-playhead-glow { --flow-peak: 0.14; }
    /* Each decorative flow follows its owning edge through tree visibility. */
    .ambient-edge-flow[data-tree-hidden] { display: none !important; animation: none !important; }
    svg[data-preset="blueprint"] .ambient-edge-flow { stroke-linecap: square; }
    svg[data-preset="editorial"] { --flow-halo-peak: 0.07; --flow-glow-peak: 0.28; --flow-tail-peak: 0.2; --flow-head-peak: 0.7; --flow-wake-peak: 0.14; --flow-ripple-peak: 0.3; }
    /* On light canvases the relay reads by saturation instead of bloom: the head
       and ripple mix toward ink instead of white, and every layer's peak rises so
       the wave survives the bright background. */
    html[data-theme="light"] svg[data-animation="trace"] {
      --flow-halo-peak: 0.22;
      --flow-glow-peak: 0.4;
      --flow-tail-peak: 0.5;
      --flow-wake-peak: 0.34;
    }
    html[data-theme="light"] .ambient-flow-head {
      stroke: color-mix(in srgb, var(--arrow-emphasis) 55%, black);
      stroke-width: 2.8;
    }
    html[data-theme="light"] .ambient-flow-ripple {
      stroke: color-mix(in srgb, var(--arrow-emphasis) 65%, black);
    }
    html[data-ambient-entry="running"] svg[data-animation="trace"] [data-animate="node"] {
      transform-box: fill-box;
      transform-origin: center;
      animation: archify-node-pulse 3.6s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="signal-flow"][data-animation="trace"] [data-animate="node"] {
      animation: archify-node-pulse 3.1s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="blueprint"][data-animation="trace"] [data-animate="node"] {
      animation: archify-blueprint-node-pulse 3.8s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-entry="running"] svg[data-preset="editorial"][data-animation="trace"] [data-animate="node"] {
      animation: archify-editorial-node-pulse 3.5s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    /* Each node glows in its planned windows: when the relay reaches it, while a
       walk token rests on it, as a message lands, or as the playhead passes.
       During the bounded entrance all three animations run; the entrance pulse is
       listed after the repeating glow and wins on filter until it completes. */
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden]) svg[data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite;
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-node-pulse 3.6s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-preset="signal-flow"][data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
        archify-node-pulse 3.1s ease-in-out 1 calc(var(--step, 0) * 160ms),
        archify-node-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards calc(var(--step, 0) * 160ms);
    }
    html[data-ambient-motion="running"][data-motion="live"]:not([data-motion-owner]):not([data-embed]):not([data-share-playback]):not([data-document-hidden])[data-ambient-entry="running"] svg[data-preset="blueprint"][data-animation="trace"] [data-animate="node"] {
      animation: var(--flow-node-name, none) var(--flow-cycle, 6.4s) linear infinite,
