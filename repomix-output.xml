export type Category = {
  id: Id
  name: string
  expiryAlertDays: number
}

export type Product = {
  id: Id
  name: string
  categoryId: Id
  priceCents: Cents
  costCents: Cents
  minStock: number
  isFavorite: boolean
  active: boolean
}

export type Lot = {
  id: Id
  productId: Id
  expiryDate: IsoDate
  unitCostCents: Cents
