    .diagram-nav [data-view="in"] { border-radius: 0 0.5rem 0.5rem 0; }
    .diagram-nav [data-view="reset"]::after,
    .diagram-nav [data-view="in"]::after {
      position: absolute;
      top: 0.55rem;
