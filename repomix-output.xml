    }
    .route-probe-status {
      display: block;
      min-height: 1.45rem;
      padding: 0.5rem 0.75rem 0.625rem;
      color: var(--text-muted, var(--text-faint));
      font-size: 0.75rem;
      line-height: 1.45;
    }
    .route-journey-controls {
      display: grid;
      grid-template-columns: 2rem minmax(5.8rem, auto) 2rem minmax(4.8rem, auto);
      justify-content: start;
