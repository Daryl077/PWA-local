      gap: 1rem;
      margin-top: 2rem;
    }

    .card {
      background: var(--panel);
      border-radius: 0.75rem;
      border: 1px solid var(--panel-border);
      padding: 1.125rem 1.25rem;
      /* Card notes are authored prose and may carry an unbreakable run such as a
         slash-joined pipeline or a long identifier. Without this, that run sets the
         card's min-content width, spills past its track in every rail placement,
         and pushes the whole page into horizontal overflow at desktop widths.
         `anywhere` rather than `break-word` because only `anywhere` shrinks the
         intrinsic minimum the layout is sized from. */
      overflow-wrap: anywhere;
    }

    html[data-preset="signal-flow"] .card {
      background: linear-gradient(145deg, rgba(10, 24, 43, 0.86), rgba(5, 12, 24, 0.92));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
