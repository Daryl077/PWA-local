        self.assertGreater(current["count"], 0)
        self.assertGreater(legacy["count"], 0)
        self.assertEqual({row["Status"] for row in current["results"]}, {"active"})
        self.assertEqual({row["Status"] for row in legacy["results"]}, {"deprecated"})
