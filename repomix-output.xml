    }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards:empty { display: none; }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards {
      display: flex;
      flex: 0 1 auto;
      flex-direction: column;
      gap: 0;
      min-height: 0;
      margin-top: 0;
      padding: 0.125rem 0 0;
      overflow-y: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 1.25rem), transparent);
      mask-image: linear-gradient(to bottom, #000 calc(100% - 1.25rem), transparent);
    }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards::-webkit-scrollbar { display: none; }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards .card { flex: none; }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards .card {
      padding: 0 0.25rem 1.125rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"]) .cards .card + .card {
