        Archify.presentation.toggle();
      } else if (e.key === 'm' || e.key === 'M') {
        e.preventDefault();
        Archify.radar.toggle();
      } else if (e.key === 'l' || e.key === 'L') {
        e.preventDefault();
        Archify.semanticLens.toggle();
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        Archify.routeProbe.toggle({ focusNode: true });
      } else if (e.key === '+' || e.key === '=') {
