        Archify.semanticLens.clear({ preserveView: true });
      } else if (e.key === 'Escape' && Archify.guide.isOpen()) {
        e.preventDefault();
        Archify.guide.close({ restoreFocus: true });
      } else if (e.key === 'Escape' && Archify.radar.isOpen()) {
