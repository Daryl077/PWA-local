    /* The reader owns only the outer scale. Compact automatic sequences fit at
       their authored text size or larger. Long sequences and waterfall rows
       favor reading width and page scroll; other diagrams keep height fitting.
       Small automatic canvases retain a modest scale inside a usable shell.
       Every strategy preserves the authored SVG/viewBox and semantic geometry. */
    .container {
      width: 100%;
      max-width: var(--archify-reader-width, 1440px);
      margin: 0 auto;
    }
    html[data-reader-area="true"] .diagram-container {
      min-height: var(--archify-diagram-min-height);
