      transition: background 0.14s ease;
    }
    .toolbar .preset-option:hover,
    .toolbar .preset-option:focus-visible { background: color-mix(in srgb, var(--text) 5%, transparent); }
    .toolbar .preset-option[aria-checked="true"] { background: color-mix(in srgb, var(--frontend-stroke) 8%, transparent); }
    .toolbar .preset-option:focus-visible {
