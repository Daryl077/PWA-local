    }
    /* Slim overlay-style thumb instead of the chunky platform default. */
    .node-finder-results::-webkit-scrollbar { width: 10px; }
    .node-finder-results::-webkit-scrollbar-track { background: transparent; }
    .node-finder-results::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--panel-border) 85%, transparent);
      border: 3px solid transparent;
      border-radius: 999px;
      background-clip: padding-box;
    }
    .node-finder-results::-webkit-scrollbar-thumb:hover {
      background: color-mix(in srgb, var(--text-muted) 65%, transparent);
      border: 3px solid transparent;
