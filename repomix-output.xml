      grid-template-columns: minmax(0, 1fr) var(--archify-rail-width);
      grid-auto-flow: row dense;
      column-gap: var(--archify-rail-gap);
      align-items: start;
    }
    html[data-reader-rail="true"] .container > .header { grid-column: 1 / -1; }
    html[data-reader-rail="true"] .container > .diagram-container { grid-column: 1; }
    /* The rail is at least the diagram's height and may run on to the viewport
       floor (--archify-rail-max, set by the reader); past that, notes scroll and
