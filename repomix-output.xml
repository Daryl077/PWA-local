        e.preventDefault();
        Archify.intentTrace.clear();
      } else if (e.key === 'Escape' && Archify.focus.active()) {
        e.preventDefault();
        Archify.focus.clear({ restoreFocus: true });
      } else if (e.key === 'Escape' && Archify.presentation.active()) {
        e.preventDefault();
