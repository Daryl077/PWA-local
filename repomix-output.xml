       follows as one panel whose groups flow into columns, so nothing scrolls
       inside it. The placement toggle sits in the index header. */
    html[data-reader-rail="bottom"] .reader-rail {
      display: grid;
      grid-template-areas: "cards" "index";
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      margin-top: 1rem;
    }
    html[data-reader-rail="bottom"] .cards { grid-area: cards; margin-top: 0; }
    html[data-reader-rail="bottom"] .cards:empty { display: none; }
    html[data-reader-rail="bottom"] .node-outline:not([hidden]) {
      display: block;
      grid-area: index;
      padding: 0 1.25rem 0.75rem;
      border: 1px solid var(--panel-border);
      border-radius: 0.75rem;
      background: var(--panel);
    }
    html[data-reader-rail="bottom"] .reader-rail > .rail-controls {
      z-index: 1;
      grid-area: index;
      align-self: start;
      justify-self: end;
      margin: 0.625rem 0.625rem 0 0;
    }
    html[data-reader-rail="bottom"] .node-outline-head { padding: 1rem 2.5rem 0.375rem 0.25rem; }
    html[data-reader-rail="bottom"] .node-outline-list {
      display: grid;
      gap: 0.5rem;
      padding: 0;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    html[data-reader-rail="bottom"] .node-outline-group + .node-outline-group { margin-top: 0; }
    html[data-reader-rail="bottom"] .node-outline-group:has(> .node-outline-heading) { padding-bottom: 0.25rem; }
    html[data-reader-rail="bottom"] .node-outline-group > ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
    }
    html[data-reader-rail="bottom"] .node-outline-group > ul::before { display: none; }
    html[data-reader-rail="bottom"] .node-outline-group li {
      flex: 0 1 auto;
      min-width: min(100%, 12rem);
      max-width: min(100%, 32rem);
    }
    html[data-reader-rail="bottom"] .node-outline-heading {
      justify-content: flex-start;
      gap: 0.5rem;
    }
    html[data-reader-rail="bottom"] .node-outline-heading > span { overflow-wrap: anywhere; }
    .rail-controls { display: none; }
    html:is([data-reader-rail="true"], [data-reader-rail="overlay"], [data-reader-rail="bottom"]) .rail-controls {
      display: flex;
      flex: none;
      justify-content: flex-end;
      gap: 0.125rem;
      margin: -0.25rem -0.25rem 0.25rem 0;
    }
    .rail-control {
      display: inline-grid;
      place-items: center;
      width: 1.875rem;
      height: 1.875rem;
      border: 0;
      border-radius: 0.5rem;
      background: transparent;
      color: var(--text-faint);
      cursor: pointer;
      transition: background 0.14s ease, color 0.14s ease;
    }
    .rail-control[hidden] { display: none; }
    .rail-control:hover,
    .rail-control:focus-visible { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); }
    .rail-control:focus-visible { outline: 1.5px solid color-mix(in srgb, var(--frontend-stroke) 60%, transparent); outline-offset: -1.5px; }
    .rail-control-icon,
    .rail-reveal-icon {
      width: 1rem;
      height: 1rem;
      background: currentColor;
