          },
          "toCardinality": {
            "enum": [
              "one",
              "many"
            ]
          },
          "fromOptional": {
            "type": "boolean"
          },
          "toOptional": {
            "type": "boolean"
          },
          "identifying": {
            "type": "boolean"
          },
          "variant": {
