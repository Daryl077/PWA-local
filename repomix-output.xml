                        "const": "fk"
                      },
                      {
                        "type": "array",
                        "contains": {
                          "const": "fk"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "key"
                ]
              },
              "then": {
                "required": [
                  "references"
