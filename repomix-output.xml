            filePath,
            sessionId,
            srcWrapper,
            checkpointReason: 'variant_anchor_missing',
            trackScroll: false,
          });
          return;
        }

        liveEl.parentElement.replaceChild(wrapper, liveEl);
        completeSourceInjection(wrapper, sessionId, { ...opts, filePath });
